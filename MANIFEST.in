recursive-include examples *.py *.json
recursive-include templates *.py *.md *.json *.sh
recursive-include integrations *.py *.md *.json *.yaml *.yml *.txt *.toml *.sh
recursive-include docs *.md *.json
recursive-include scripts *.sh *.py
recursive-include tests *.py *.json *.txt *.sv *.png *.wbt LICENSE
recursive-include tests/fixtures/jobbench *
recursive-include tests/fixtures/ahe_native *
recursive-include tests/fixtures/harnessx_native *
recursive-include LICENSES *.txt
include THIRD_PARTY_NOTICES.md
include handsoff.md
include AGENTS.md
prune .tools
prune .runtime
prune .managed
prune .venv
prune .venv-core-check
prune lmms-eval
prune meta-harness
prune rrsi
global-exclude __pycache__ *.py[cod] auth.json
