recursive-include examples *.py *.json
recursive-include templates *.py *.md *.json *.sh
recursive-include integrations *.py *.md *.json *.yaml *.yml *.txt *.toml *.sh
recursive-include docs *.md *.json
include scripts/mac-env.sh
include scripts/setup-nvidia-docker.sh
include LICENSE
recursive-include LICENSES *.txt
include THIRD_PARTY_NOTICES.md
exclude AGENTS.md
prune tests
prune .github
prune .tools
prune .runtime
prune .managed
prune .venv
prune .venv-core-check
prune lmms-eval
prune meta-harness
prune rrsi
global-exclude __pycache__ *.py[cod] auth.json
